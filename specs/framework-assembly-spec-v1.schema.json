{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shidai3.local/schemas/framework-assembly-spec-v1.schema.json",
  "title": "FrameworkAssemblySpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "graphId",
    "protocolVersion",
    "runId",
    "projectId",
    "milestoneId",
    "gameSpecSha256",
    "gameSpecArtifactRevision",
    "gameSpecApprovalReceiptSha256",
    "frameworkId",
    "frameworkVersionConstraint",
    "requiredMaturity",
    "manifestSchemaVersion",
    "manifestSha256",
    "frameworkGitRevision",
    "requirements",
    "createdAt",
    "artifactSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "framework-assembly-spec-v1" },
    "graphId": { "const": "studio_workflow_v2" },
    "protocolVersion": { "const": 2 },
    "runId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "milestoneId": { "type": "string", "minLength": 1 },
    "gameSpecSha256": { "$ref": "#/$defs/sha256" },
    "gameSpecArtifactRevision": { "type": "integer", "minimum": 1 },
    "gameSpecApprovalReceiptSha256": { "$ref": "#/$defs/sha256" },
    "frameworkId": { "$ref": "#/$defs/identifier" },
    "frameworkVersionConstraint": { "$ref": "#/$defs/version" },
    "requiredMaturity": { "enum": ["IMPLEMENTED", "VERIFIED"] },
    "manifestSchemaVersion": { "const": "framework-manifest-v1" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "frameworkGitRevision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "features", "rulesets"],
      "properties": {
        "capabilities": { "$ref": "#/$defs/references" },
        "features": { "$ref": "#/$defs/references" },
        "rulesets": { "$ref": "#/$defs/references" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "artifactSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "reference": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "version": { "$ref": "#/$defs/version" },
            "kind": { "enum": ["capability", "feature", "ruleset"] }
          }
        }
      ]
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" },
      "uniqueItems": true
    }
  }
}
