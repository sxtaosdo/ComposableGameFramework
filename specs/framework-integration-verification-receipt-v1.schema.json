{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shidai3.local/schemas/framework-integration-verification-receipt-v1.schema.json",
  "title": "Framework Integration Verification Receipt v1",
  "description": "Read-only post-integration gate bound to exact framework and product Git revisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "status", "runId", "projectId", "milestoneId",
    "baselineRevision", "productGitRevision", "frameworkId", "frameworkVersion",
    "frameworkStatus", "manifestSha256", "frameworkGitRevision", "executionStage",
    "requiredMaturity", "gameSpecSha256", "gameSpecArtifactRevision",
    "assemblySpecSha256", "frameworkGapReceiptSha256", "integrationRevision",
    "frameworkGapStatus", "engineSelection", "changedPaths", "publicApiImports",
    "forbiddenImports", "protectedPathMutations", "checks", "productionEligible",
    "failureReasons", "verifiedAt", "receiptSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "framework-integration-verification-receipt-v1" },
    "status": { "enum": ["PASSED", "BLOCKED"] },
    "runId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "milestoneId": { "type": "string", "minLength": 1 },
    "baselineRevision": { "$ref": "#/$defs/gitRevision" },
    "productGitRevision": { "$ref": "#/$defs/gitRevision" },
    "frameworkId": { "$ref": "#/$defs/identifier" },
    "frameworkVersion": { "$ref": "#/$defs/version" },
    "frameworkStatus": { "$ref": "#/$defs/maturity" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "frameworkGitRevision": { "$ref": "#/$defs/gitRevision" },
    "executionStage": { "enum": ["DEVELOPMENT", "RELEASE"] },
    "requiredMaturity": { "enum": ["IMPLEMENTED", "VERIFIED"] },
    "gameSpecSha256": { "$ref": "#/$defs/sha256" },
    "gameSpecArtifactRevision": { "type": "integer", "minimum": 1 },
    "assemblySpecSha256": { "$ref": "#/$defs/sha256" },
    "frameworkGapReceiptSha256": { "$ref": "#/$defs/sha256" },
    "integrationRevision": { "$ref": "#/$defs/gitRevision" },
    "frameworkGapStatus": { "enum": ["CLEAR", "BLOCKED"] },
    "engineSelection": { "$ref": "#/$defs/engineSelection" },
    "changedPaths": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
    "publicApiImports": { "type": "array", "items": { "$ref": "#/$defs/importReference" } },
    "forbiddenImports": { "type": "array", "items": { "$ref": "#/$defs/importReference" } },
    "protectedPathMutations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "reason"],
        "properties": { "path": { "$ref": "#/$defs/path" }, "reason": { "type": "string", "minLength": 1 } }
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot", "revision", "maturity", "engine", "publicApi", "protectedPaths", "authority"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/check" }, "revision": { "$ref": "#/$defs/check" },
        "maturity": { "$ref": "#/$defs/check" }, "engine": { "$ref": "#/$defs/check" },
        "publicApi": { "$ref": "#/$defs/check" }, "protectedPaths": { "$ref": "#/$defs/check" },
        "authority": { "$ref": "#/$defs/check" }
      }
    },
    "productionEligible": { "type": "boolean" },
    "failureReasons": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^FRAMEWORK_[A-Z0-9_]+$" },
          "message": { "type": "string", "minLength": 1 }, "path": { "$ref": "#/$defs/path" }
        }
      }
    },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "receiptSha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASSED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "productionEligible": { "const": true }, "frameworkGapStatus": { "const": "CLEAR" },
          "forbiddenImports": { "type": "array", "maxItems": 0 }, "protectedPathMutations": { "type": "array", "maxItems": 0 },
          "failureReasons": { "type": "array", "maxItems": 0 },
          "checks": {
            "type": "object",
            "properties": {
              "snapshot": { "const": "PASS" }, "revision": { "const": "PASS" },
              "maturity": { "const": "PASS" }, "engine": { "const": "PASS" },
              "publicApi": { "const": "PASS" }, "protectedPaths": { "const": "PASS" },
              "authority": { "const": "PASS" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "BLOCKED" } }, "required": ["status"] },
      "then": { "properties": { "productionEligible": { "const": false }, "failureReasons": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "requiredMaturity": { "const": "VERIFIED" } }, "required": ["requiredMaturity"] },
      "then": { "properties": { "frameworkStatus": { "const": "VERIFIED" } } }
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?(?:[-+][0-9A-Za-z.-]+)?$" },
    "maturity": { "enum": ["DESIGN_ONLY", "IMPLEMENTED", "VERIFIED", "DEPRECATED"] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitRevision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "check": { "enum": ["PASS", "FAIL"] },
    "engineSelection": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "version": { "$ref": "#/$defs/version" },
        "source": { "const": "OWNER_APPROVED_GAME_SPEC" }
      }
    },
    "importReference": {
      "type": "object", "additionalProperties": false, "required": ["path", "specifier"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "specifier": { "type": "string", "minLength": 1 } }
    }
  }
}
