{
  "package_version": 2,
  "name": "shidai3",
  "title": "Shidai3 Framework",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Composable Game Framework as a Cocos Creator extension.",
  "author": "Shidai3",
  "editor": ">=3.8.0",
  "main": "./main.cjs",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/normalize-dist-imports.mjs",
    "contracts": "node scripts/validate-contracts.mjs",
    "standards": "node scripts/validate-engineering-standards.mjs",
    "sample:headless": "node dist/examples/tile-match/run.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "contributions": {
    "asset-db": {
      "mount": {
        "path": "./assets",
        "readonly": true
      }
    }
  }
}
