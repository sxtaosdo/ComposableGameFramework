{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shidai3.local/schemas/framework-integration-verification-receipt-v1.schema.json",
  "title": "Framework Integration Verification Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "runId",
    "projectId",
    "milestoneId",
    "productGitRevision",
    "gameSpecSha256",
    "assemblySpecSha256",
    "frameworkGapReceiptSha256",
    "frameworkGapStatus",
    "frameworkId",
    "frameworkVersion",
    "frameworkStatus",
    "requiredMaturity",
    "manifestSchemaVersion",
    "manifestSha256",
    "frameworkGitRevision",
    "checks",
    "protectedPathMutations",
    "failureReasons",
    "productionEligible",
    "verifiedAt",
    "receiptSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "framework-integration-verification-receipt-v1" },
    "status": { "enum": ["PASSED", "BLOCKED"] },
    "runId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "milestoneId": { "type": "string", "minLength": 1 },
    "productGitRevision": { "$ref": "#/$defs/gitRevision" },
    "gameSpecSha256": { "$ref": "#/$defs/sha256" },
    "assemblySpecSha256": { "$ref": "#/$defs/sha256" },
    "frameworkGapReceiptSha256": { "$ref": "#/$defs/sha256" },
    "frameworkGapStatus": { "enum": ["CLEAR", "BLOCKED"] },
    "frameworkId": { "$ref": "#/$defs/identifier" },
    "frameworkVersion": { "$ref": "#/$defs/version" },
    "frameworkStatus": { "$ref": "#/$defs/maturity" },
    "requiredMaturity": { "enum": ["IMPLEMENTED", "VERIFIED"] },
    "manifestSchemaVersion": { "const": "framework-manifest-v1" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "frameworkGitRevision": { "$ref": "#/$defs/gitRevision" },
    "engineSelection": { "$ref": "#/$defs/engineSelection" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameworkVersion",
        "manifestSnapshot",
        "frameworkRevision",
        "featureVersions",
        "dependencyGraph",
        "rulesetBindings",
        "capabilities",
        "saveSchema",
        "publicApi",
        "engineCompatibility",
        "forbiddenImports",
        "protectedPaths",
        "authority"
      ],
      "properties": {
        "frameworkVersion": { "$ref": "#/$defs/check" },
        "manifestSnapshot": { "$ref": "#/$defs/check" },
        "frameworkRevision": { "$ref": "#/$defs/check" },
        "featureVersions": { "$ref": "#/$defs/check" },
        "dependencyGraph": { "$ref": "#/$defs/check" },
        "rulesetBindings": { "$ref": "#/$defs/check" },
        "capabilities": { "$ref": "#/$defs/check" },
        "saveSchema": { "$ref": "#/$defs/check" },
        "publicApi": { "$ref": "#/$defs/check" },
        "engineCompatibility": { "$ref": "#/$defs/check" },
        "forbiddenImports": { "$ref": "#/$defs/check" },
        "protectedPaths": { "$ref": "#/$defs/check" },
        "authority": { "$ref": "#/$defs/check" }
      }
    },
    "protectedPathMutations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["areaId", "path", "policyResult"],
        "properties": {
          "areaId": { "$ref": "#/$defs/identifier" },
          "path": { "$ref": "#/$defs/relativePath" },
          "policyResult": { "const": "BLOCKED" },
          "changeProposalSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "failureReasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^FRAMEWORK_[A-Z0-9_]+$" },
          "message": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "productionEligible": { "type": "boolean" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "receiptSha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "type": "object", "required": ["status"], "properties": { "status": { "const": "PASSED" } } },
      "then": {
        "properties": {
          "productionEligible": { "const": true },
          "frameworkGapStatus": { "const": "CLEAR" },
          "frameworkStatus": { "enum": ["IMPLEMENTED", "VERIFIED"] },
          "protectedPathMutations": { "type": "array", "maxItems": 0 },
          "failureReasons": { "type": "array", "maxItems": 0 },
          "checks": {
            "type": "object",
            "properties": {
              "frameworkVersion": { "$ref": "#/$defs/passingCheck" },
              "manifestSnapshot": { "$ref": "#/$defs/passingCheck" },
              "frameworkRevision": { "$ref": "#/$defs/passingCheck" },
              "featureVersions": { "$ref": "#/$defs/passingCheck" },
              "dependencyGraph": { "$ref": "#/$defs/passingCheck" },
              "rulesetBindings": { "$ref": "#/$defs/passingCheck" },
              "capabilities": { "$ref": "#/$defs/passingCheck" },
              "saveSchema": { "$ref": "#/$defs/nonFailingCheck" },
              "publicApi": { "$ref": "#/$defs/passingCheck" },
              "engineCompatibility": { "$ref": "#/$defs/nonFailingCheck" },
              "forbiddenImports": { "$ref": "#/$defs/passingCheck" },
              "protectedPaths": { "$ref": "#/$defs/passingCheck" },
              "authority": { "$ref": "#/$defs/passingCheck" }
            }
          }
        }
      }
    },
    {
      "if": { "type": "object", "required": ["status"], "properties": { "status": { "const": "BLOCKED" } } },
      "then": {
        "properties": {
          "productionEligible": { "const": false },
          "failureReasons": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": { "type": "object", "required": ["requiredMaturity"], "properties": { "requiredMaturity": { "const": "VERIFIED" } } },
      "then": { "type": "object", "properties": { "frameworkStatus": { "const": "VERIFIED" } } }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "maturity": {
      "enum": ["DESIGN_ONLY", "IMPLEMENTED", "VERIFIED", "DEPRECATED"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "engineSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "source": { "const": "OWNER_APPROVED_GAME_SPEC" }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256"],
      "properties": {
        "artifact": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "NOT_APPLICABLE"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceReference" }
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "type": "object", "required": ["status"], "properties": { "status": { "const": "PASS" } } },
          "then": { "properties": { "evidence": { "type": "array", "minItems": 1 } } }
        },
        {
          "if": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["FAIL", "NOT_APPLICABLE"] } } },
          "then": {
            "required": ["reason"],
            "properties": { "reason": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "nonFailingCheck": {
      "allOf": [
        { "$ref": "#/$defs/check" },
        { "type": "object", "properties": { "status": { "enum": ["PASS", "NOT_APPLICABLE"] } } }
      ]
    },
    "passingCheck": {
      "allOf": [
        { "$ref": "#/$defs/check" },
        { "type": "object", "properties": { "status": { "const": "PASS" } } }
      ]
    }
  }
}
