{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shidai3.local/schemas/framework-manifest-v1.schema.json",
  "title": "Framework Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "framework",
    "catalogs",
    "saveSchemas",
    "contracts",
    "publicApi",
    "compatibility",
    "protectedAreas",
    "protectedPathRules",
    "evidence",
    "documentCount"
  ],
  "properties": {
    "schemaVersion": { "const": "framework-manifest-v1" },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "status": { "$ref": "#/$defs/maturity" }
      }
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "features", "rulesets", "commands", "queries", "events", "effects"],
      "properties": {
        "capabilities": { "$ref": "#/$defs/catalog" },
        "features": { "$ref": "#/$defs/catalog" },
        "rulesets": { "$ref": "#/$defs/catalog" },
        "commands": { "$ref": "#/$defs/catalog" },
        "queries": { "$ref": "#/$defs/catalog" },
        "events": { "$ref": "#/$defs/catalog" },
        "effects": { "$ref": "#/$defs/catalog" }
      }
    },
    "saveSchemas": {
      "type": "array",
      "items": { "$ref": "#/$defs/saveSchema" },
      "uniqueItems": true
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contract" }
    },
    "publicApi": { "$ref": "#/$defs/frameworkPublicApi" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engines"],
      "properties": {
        "engines": {
          "type": "array",
          "items": { "$ref": "#/$defs/engineCompatibility" }
        }
      }
    },
    "protectedAreas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "protectedPathRules": { "$ref": "#/$defs/protectedPathRules" },
    "evidence": { "$ref": "#/$defs/frameworkEvidence" },
    "documentCount": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "type": "object", "required": ["framework"], "properties": { "framework": { "type": "object", "required": ["status"], "properties": { "status": { "const": "DESIGN_ONLY" } } } } },
      "then": {
        "properties": {
          "publicApi": { "type": "object", "properties": { "status": { "const": "DESIGN_ONLY" } } },
          "protectedPathRules": {
            "type": "object",
            "properties": {
              "mode": { "const": "DENY_ALL_FRAMEWORK_MUTATION" },
              "rules": { "type": "array", "maxItems": 0 }
            }
          },
          "evidence": {
            "type": "object",
            "properties": {
              "implementation": { "enum": ["NOT_IMPLEMENTED", "PARTIALLY_IMPLEMENTED"] },
              "runtimeVerification": { "const": "NOT_RUN" },
              "productAcceptance": { "const": "NOT_RUN" }
            }
          }
        }
      }
    },
    {
      "if": { "type": "object", "required": ["framework"], "properties": { "framework": { "type": "object", "required": ["status"], "properties": { "status": { "const": "IMPLEMENTED" } } } } },
      "then": {
        "properties": {
          "publicApi": { "$ref": "#/$defs/implementedFrameworkPublicApi" },
          "protectedPathRules": { "$ref": "#/$defs/declaredProtectedPathRules" },
          "evidence": { "$ref": "#/$defs/implementedFrameworkEvidence" }
        }
      }
    },
    {
      "if": { "type": "object", "required": ["framework"], "properties": { "framework": { "type": "object", "required": ["status"], "properties": { "status": { "const": "VERIFIED" } } } } },
      "then": {
        "properties": {
          "publicApi": { "$ref": "#/$defs/verifiedFrameworkPublicApi" },
          "protectedPathRules": { "$ref": "#/$defs/declaredProtectedPathRules" },
          "evidence": { "$ref": "#/$defs/verifiedFrameworkEvidence" }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._*-]+)*$"
    },
    "maturity": {
      "enum": ["DESIGN_ONLY", "IMPLEMENTED", "VERIFIED", "DEPRECATED"]
    },
    "reference": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "version": { "$ref": "#/$defs/version" },
            "kind": { "enum": ["capability", "feature", "ruleset", "command", "query", "event", "effect", "save-schema"] }
          }
        }
      ]
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" },
      "uniqueItems": true
    },
    "publicApi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exports", "commands", "queries", "events", "effects", "saveSchemas"],
      "properties": {
        "exports": { "$ref": "#/$defs/references" },
        "commands": { "$ref": "#/$defs/references" },
        "queries": { "$ref": "#/$defs/references" },
        "events": { "$ref": "#/$defs/references" },
        "effects": { "$ref": "#/$defs/references" },
        "saveSchemas": { "$ref": "#/$defs/references" }
      }
    },
    "nonEmptyApiSurface": {
      "anyOf": [
        { "type": "object", "properties": { "exports": { "type": "array", "minItems": 1 } } },
        { "type": "object", "properties": { "commands": { "type": "array", "minItems": 1 } } },
        { "type": "object", "properties": { "queries": { "type": "array", "minItems": 1 } } },
        { "type": "object", "properties": { "events": { "type": "array", "minItems": 1 } } },
        { "type": "object", "properties": { "effects": { "type": "array", "minItems": 1 } } },
        { "type": "object", "properties": { "saveSchemas": { "type": "array", "minItems": 1 } } }
      ]
    },
    "catalogEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implementationReceiptSha256": { "$ref": "#/$defs/sha256" },
        "implementationReceiptPath": { "$ref": "#/$defs/relativePath" },
        "runtimeVerificationReceiptSha256": { "$ref": "#/$defs/sha256" },
        "runtimeVerificationReceiptPath": { "$ref": "#/$defs/relativePath" },
        "sourceRevision": { "$ref": "#/$defs/gitRevision" }
      }
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "document"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "status": { "$ref": "#/$defs/maturity" },
        "document": { "$ref": "#/$defs/relativePath" },
        "dependsOn": { "$ref": "#/$defs/references" },
        "capabilities": { "$ref": "#/$defs/references" },
        "requiredCapabilities": { "$ref": "#/$defs/references" },
        "dependencies": { "$ref": "#/$defs/references" },
        "rulesets": { "$ref": "#/$defs/references" },
        "requiredRulesets": { "$ref": "#/$defs/references" },
        "features": { "$ref": "#/$defs/references" },
        "requiredFeatures": { "$ref": "#/$defs/references" },
        "publicApi": { "$ref": "#/$defs/publicApi" },
        "evidence": { "$ref": "#/$defs/catalogEvidence" }
      },
      "allOf": [
        {
          "if": { "type": "object", "required": ["status"], "properties": { "status": { "const": "IMPLEMENTED" } } },
          "then": {
            "required": ["version", "publicApi", "evidence"],
            "properties": {
              "version": { "$ref": "#/$defs/version" },
              "publicApi": {
                "allOf": [
                  { "$ref": "#/$defs/publicApi" },
                  { "$ref": "#/$defs/nonEmptyApiSurface" }
                ]
              },
              "evidence": {
                "type": "object",
                "required": ["implementationReceiptSha256", "implementationReceiptPath", "sourceRevision"],
                "properties": {
                  "implementationReceiptSha256": { "$ref": "#/$defs/sha256" },
                  "implementationReceiptPath": { "$ref": "#/$defs/relativePath" },
                  "sourceRevision": { "$ref": "#/$defs/gitRevision" }
                }
              }
            }
          }
        },
        {
          "if": { "type": "object", "required": ["status"], "properties": { "status": { "const": "VERIFIED" } } },
          "then": {
            "required": ["version", "publicApi", "evidence"],
            "properties": {
              "version": { "$ref": "#/$defs/version" },
              "publicApi": {
                "allOf": [
                  { "$ref": "#/$defs/publicApi" },
                  { "$ref": "#/$defs/nonEmptyApiSurface" }
                ]
              },
              "evidence": {
                "type": "object",
                "required": ["implementationReceiptSha256", "implementationReceiptPath", "runtimeVerificationReceiptSha256", "runtimeVerificationReceiptPath", "sourceRevision"],
                "properties": {
                  "implementationReceiptSha256": { "$ref": "#/$defs/sha256" },
                  "implementationReceiptPath": { "$ref": "#/$defs/relativePath" },
                  "runtimeVerificationReceiptSha256": { "$ref": "#/$defs/sha256" },
                  "runtimeVerificationReceiptPath": { "$ref": "#/$defs/relativePath" },
                  "sourceRevision": { "$ref": "#/$defs/gitRevision" }
                }
              }
            }
          }
        }
      ]
    },
    "catalog": {
      "type": "array",
      "items": { "$ref": "#/$defs/catalogEntry" }
    },
    "saveSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "schemaPath"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "status": { "$ref": "#/$defs/maturity" },
        "schemaPath": { "$ref": "#/$defs/relativePath" },
        "evidence": { "$ref": "#/$defs/catalogEvidence" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "schemaPath", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "schemaVersion": { "$ref": "#/$defs/identifier" },
        "schemaPath": { "$ref": "#/$defs/relativePath" },
        "evidence": { "const": "MACHINE_SCHEMA_ONLY" }
      }
    },
    "frameworkPublicApi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exports", "commands", "queries", "events", "effects", "saveSchemas"],
      "properties": {
        "status": { "$ref": "#/$defs/maturity" },
        "exports": { "$ref": "#/$defs/references" },
        "commands": { "$ref": "#/$defs/references" },
        "queries": { "$ref": "#/$defs/references" },
        "events": { "$ref": "#/$defs/references" },
        "effects": { "$ref": "#/$defs/references" },
        "saveSchemas": { "$ref": "#/$defs/references" }
      }
    },
    "implementedFrameworkPublicApi": {
      "allOf": [
        { "$ref": "#/$defs/frameworkPublicApi" },
        { "type": "object", "properties": { "status": { "const": "IMPLEMENTED" } } },
        { "$ref": "#/$defs/nonEmptyApiSurface" }
      ]
    },
    "verifiedFrameworkPublicApi": {
      "allOf": [
        { "$ref": "#/$defs/frameworkPublicApi" },
        { "type": "object", "properties": { "status": { "const": "VERIFIED" } } },
        { "$ref": "#/$defs/nonEmptyApiSurface" }
      ]
    },
    "engineCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versionRange", "status", "document"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "versionRange": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/maturity" },
        "document": { "$ref": "#/$defs/relativePath" },
        "adapterPublicApi": { "$ref": "#/$defs/publicApi" },
        "evidence": { "$ref": "#/$defs/catalogEvidence" }
      },
      "allOf": [
        {
          "if": { "type": "object", "required": ["status"], "properties": { "status": { "const": "IMPLEMENTED" } } },
          "then": {
            "required": ["adapterPublicApi", "evidence"],
            "properties": {
              "adapterPublicApi": { "$ref": "#/$defs/publicApi" },
              "evidence": {
                "type": "object",
                "required": ["implementationReceiptSha256", "implementationReceiptPath", "sourceRevision"],
                "properties": {
                  "implementationReceiptSha256": { "$ref": "#/$defs/sha256" },
                  "implementationReceiptPath": { "$ref": "#/$defs/relativePath" },
                  "sourceRevision": { "$ref": "#/$defs/gitRevision" }
                }
              }
            }
          }
        },
        {
          "if": { "type": "object", "required": ["status"], "properties": { "status": { "const": "VERIFIED" } } },
          "then": {
            "required": ["adapterPublicApi", "evidence"],
            "properties": {
              "adapterPublicApi": { "$ref": "#/$defs/publicApi" },
              "evidence": {
                "type": "object",
                "required": ["implementationReceiptSha256", "implementationReceiptPath", "runtimeVerificationReceiptSha256", "runtimeVerificationReceiptPath", "sourceRevision"],
                "properties": {
                  "implementationReceiptSha256": { "$ref": "#/$defs/sha256" },
                  "implementationReceiptPath": { "$ref": "#/$defs/relativePath" },
                  "runtimeVerificationReceiptSha256": { "$ref": "#/$defs/sha256" },
                  "runtimeVerificationReceiptPath": { "$ref": "#/$defs/relativePath" },
                  "sourceRevision": { "$ref": "#/$defs/gitRevision" }
                }
              }
            }
          }
        }
      ]
    },
    "protectedPathRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["areaId", "pathPatterns", "mutationPolicy"],
      "properties": {
        "areaId": { "$ref": "#/$defs/identifier" },
        "pathPatterns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "mutationPolicy": { "const": "CHANGE_PROPOSAL_AND_OWNER_APPROVAL_REQUIRED" }
      }
    },
    "protectedPathRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rules"],
      "properties": {
        "mode": { "enum": ["DENY_ALL_FRAMEWORK_MUTATION", "DECLARED_PROTECTED_PATHS"] },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/protectedPathRule" }
        }
      }
    },
    "declaredProtectedPathRules": {
      "allOf": [
        { "$ref": "#/$defs/protectedPathRules" },
        { "type": "object", "properties": { "mode": { "const": "DECLARED_PROTECTED_PATHS" }, "rules": { "type": "array", "minItems": 1 } } }
      ]
    },
    "implementationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceRevision", "receiptPath", "receiptSha256"],
      "properties": {
        "status": { "const": "IMPLEMENTED" },
        "sourceRevision": { "$ref": "#/$defs/gitRevision" },
        "receiptPath": { "$ref": "#/$defs/relativePath" },
        "receiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receiptPath", "receiptSha256"],
      "properties": {
        "status": { "const": "VERIFIED" },
        "receiptPath": { "$ref": "#/$defs/relativePath" },
        "receiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "acceptanceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receiptPath", "receiptSha256"],
      "properties": {
        "status": { "const": "ACCEPTED" },
        "receiptPath": { "$ref": "#/$defs/relativePath" },
        "receiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "frameworkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "implementation", "runtimeVerification", "productAcceptance"],
      "properties": {
        "design": { "const": "DOCUMENTED" },
        "implementation": { "oneOf": [{ "enum": ["NOT_IMPLEMENTED", "PARTIALLY_IMPLEMENTED"] }, { "$ref": "#/$defs/implementationEvidence" }] },
        "runtimeVerification": { "oneOf": [{ "const": "NOT_RUN" }, { "$ref": "#/$defs/runtimeEvidence" }] },
        "productAcceptance": { "oneOf": [{ "const": "NOT_RUN" }, { "$ref": "#/$defs/acceptanceEvidence" }] }
      }
    },
    "implementedFrameworkEvidence": {
      "allOf": [
        { "$ref": "#/$defs/frameworkEvidence" },
        { "type": "object", "properties": { "implementation": { "$ref": "#/$defs/implementationEvidence" } } }
      ]
    },
    "verifiedFrameworkEvidence": {
      "allOf": [
        { "$ref": "#/$defs/implementedFrameworkEvidence" },
        { "type": "object", "properties": { "runtimeVerification": { "$ref": "#/$defs/runtimeEvidence" } } }
      ]
    }
  }
}
